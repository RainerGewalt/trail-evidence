{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RainerGewalt/trail-evidence/schema/trail-evidence-1.schema.json",
  "title": "Trail Evidence Record v1",
  "description": "One hash-chained evidence record as defined in SPEC.md. Typed objects are closed (additionalProperties false); payload and context are free-form.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "producer", "stream_id", "seq", "prev_hash", "event_type",
    "time", "actor", "policy", "payload", "content_hash", "chain_hash"
  ],
  "properties": {
    "schema": { "const": "trail.evidence/1" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version"],
      "properties": {
        "kind": { "enum": ["broker", "transfer-worker", "source-bridge", "ml-pipeline", "persistence", "other"] },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "stream_id": { "type": "string", "minLength": 1 },
    "seq": { "type": "integer", "minimum": 0 },
    "chain_restart": { "const": true },
    "anchor_hash": { "$ref": "#/$defs/hash" },
    "prev_hash": { "$ref": "#/$defs/hash" },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_-]*$"
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recorded_at", "source"],
      "properties": {
        "recorded_at": { "$ref": "#/$defs/recordedAt" },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "read_at": { "$ref": "#/$defs/timestamp" },
        "source": { "enum": ["system", "ntp", "tsa", "seq-reconstructed", "unknown"] }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auth"],
      "properties": {
        "auth": { "enum": ["broker-authenticated", "self-declared", "operator-token", "none"] },
        "id": { "type": "string" },
        "roles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "hash": { "$ref": "#/$defs/hash" },
        "status": { "enum": ["draft", "validated", "approved", "active", "retired"] },
        "kind": { "type": "string" }
      }
    },
    "correlation_id": { "type": "string", "minLength": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "decision_id": { "type": "string", "minLength": 1 },
    "payload": {
      "description": "Any JSON value. Its RFC 8785 canonical form is hashed into content_hash."
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "method"],
      "properties": {
        "fields": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(/([^/~]|~0|~1)*)*$" }
        },
        "method": { "type": "string", "minLength": 1 }
      }
    },
    "content_hash": { "$ref": "#/$defs/hash" },
    "chain_hash": { "$ref": "#/$defs/hash" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "key_id", "sig"],
      "properties": {
        "alg": { "const": "ed25519" },
        "key_id": { "type": "string", "minLength": 1 },
        "sig": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "enum": ["trailmq", "tsa", "worm", "other"] },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "context": {
      "type": "object",
      "description": "Informational members. Never part of any hash."
    }
  },
  "dependentRequired": {
    "chain_restart": ["anchor_hash"],
    "anchor_hash": ["chain_restart"]
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3,9}Z$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    }
  }
}
