{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RainerGewalt/trail-evidence/schema/trail-evidence-1.schema.json",
  "title": "Trail Evidence Record v1",
  "description": "One hash-chained evidence record as defined in SPEC.md (format 0.2). Typed objects are closed (additionalProperties false); payload and context are free-form. A profile constrains payload further; its schema is in profiles/<name>/<major>.schema.json. Rules this schema cannot express (restart invariants, hashes, chaining) are checked by the verifiers. A record whose schema member names another format or major version is outside the scope of this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "producer", "stream_id", "seq", "prev_hash", "event_type",
    "time", "actor", "policy", "payload", "content_hash", "chain_hash"
  ],
  "properties": {
    "schema": { "const": "trail.evidence/1" },
    "profile": {
      "description": "Profile of the payload, <name>/<major>. Part of the chain core when present.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+/[1-9][0-9]*$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version"],
      "properties": {
        "kind": { "enum": ["broker", "transfer-worker", "source-bridge", "ml-pipeline", "persistence", "other"] },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "stream_id": { "type": "string", "minLength": 1 },
    "seq": {
      "description": "Position in the stream as a decimal string, \"0\" to \"18446744073709551615\". A JSON integer (the form of format 0.1) is accepted during 0.x with the notice legacy_integer_seq and is schema_invalid from 1.0.",
      "oneOf": [
        { "type": "string", "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$" },
        { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 }
      ]
    },
    "chain_restart": { "const": true },
    "anchor_hash": { "$ref": "#/$defs/hash" },
    "prev_hash": { "$ref": "#/$defs/hash" },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_-]*$"
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recorded_at", "source"],
      "properties": {
        "recorded_at": { "$ref": "#/$defs/recordedAt" },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "read_at": { "$ref": "#/$defs/timestamp" },
        "source": { "enum": ["system", "ntp", "tsa", "seq-reconstructed", "unknown"] }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auth"],
      "properties": {
        "auth": { "enum": ["broker-authenticated", "self-declared", "operator-token", "none"] },
        "id": { "type": "string" },
        "roles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "hash": { "$ref": "#/$defs/hash" },
        "status": { "enum": ["draft", "validated", "approved", "active", "retired"] },
        "kind": { "type": "string" }
      }
    },
    "correlation_id": { "type": "string", "minLength": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "decision_id": { "type": "string", "minLength": 1 },
    "payload": {
      "description": "Any JSON value. Its RFC 8785 canonical form is hashed into content_hash."
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "method"],
      "properties": {
        "fields": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(/([^/~]|~0|~1)*)*$" }
        },
        "method": { "type": "string", "minLength": 1 }
      }
    },
    "content_hash": { "$ref": "#/$defs/hash" },
    "chain_hash": { "$ref": "#/$defs/hash" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "key_id", "sig"],
      "properties": {
        "alg": { "const": "ed25519" },
        "key_id": { "type": "string", "minLength": 1 },
        "sig": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "enum": ["trailmq", "tsa", "worm", "other"] },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "context": {
      "type": "object",
      "description": "Informational members. Never part of any hash."
    }
  },
  "dependentRequired": {
    "chain_restart": ["anchor_hash"],
    "anchor_hash": ["chain_restart"]
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3,9}Z$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    }
  }
}
