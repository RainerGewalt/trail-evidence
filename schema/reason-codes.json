{
  "$schema": "./reason-codes.schema.json",
  "name": "trail.evidence/1 reason codes",
  "version": "0.1.0",
  "status": "draft",
  "description": "Shared vocabulary for payload.reason_code across the producer kinds of trail.evidence/1. The mqtt namespace mirrors the authorization reasons of a reference broker; other brokers may add their own mqtt codes. Documentation only: verifiers do not check reason codes. docs/REASON_CODES.md is generated from this file by scripts/reason_codes.py.",
  "severities": {
    "info": "The event happened as intended. Nothing to follow up.",
    "warning": "The operation was refused by design, or it completed in a degraded way. The evidence is complete; someone should look.",
    "error": "The operation failed, or facts the producer should have recorded are missing."
  },
  "namespaces": {
    "transfer": {
      "producer_kinds": [
        "transfer-worker"
      ],
      "description": "File transfer jobs (TrailTransfer): results and rejections."
    },
    "mqtt": {
      "producer_kinds": [
        "broker"
      ],
      "description": "Broker access decisions, as written by an export adapter. The codes mirror the authorization reasons of a reference broker; other brokers may add their own codes in this namespace."
    },
    "source": {
      "producer_kinds": [
        "source-bridge"
      ],
      "description": "Source bridges (TrailSource): address space, value quality, connection."
    },
    "ml": {
      "producer_kinds": [
        "ml-pipeline"
      ],
      "description": "ML pipelines: run lifecycle, acceptance against the recipe, predictions."
    },
    "common": {
      "producer_kinds": [
        "broker",
        "transfer-worker",
        "source-bridge",
        "ml-pipeline",
        "persistence",
        "other"
      ],
      "description": "Conditions every producer can hit: gaps, restarts, configuration changes, clock problems."
    }
  },
  "codes": [
    {
      "code": "transfer.completed",
      "namespace": "transfer",
      "severity": "info",
      "meaning": "The job ran to the end and every file reached the target.",
      "producer_kinds": [
        "transfer-worker"
      ],
      "example": {
        "event_type": "transfer.job.result",
        "payload": {
          "action": "copy",
          "status": "ok",
          "files": 1,
          "reason_code": "transfer.completed"
        }
      },
      "derived_from": "examples/transfer-worker.jsonl (records 0, 1, 3); TrailTransfer status completed"
    },
    {
      "code": "transfer.source_not_found",
      "namespace": "transfer",
      "severity": "error",
      "meaning": "The source path did not exist when the job ran; nothing was transferred.",
      "producer_kinds": [
        "transfer-worker"
      ],
      "example": {
        "event_type": "transfer.job.result",
        "payload": {
          "action": "copy",
          "status": "failed",
          "error": "source not found",
          "files": 0,
          "reason_code": "transfer.source_not_found"
        }
      },
      "derived_from": "examples/transfer-worker.jsonl (record 2)"
    },
    {
      "code": "transfer.target_write_failed",
      "namespace": "transfer",
      "severity": "error",
      "meaning": "The target refused or failed a write (permission, quota, network); the job stopped.",
      "producer_kinds": [
        "transfer-worker"
      ],
      "example": {
        "event_type": "transfer.job.result",
        "payload": {
          "action": "copy",
          "status": "failed",
          "error": "s3: AccessDenied",
          "files": 0,
          "reason_code": "transfer.target_write_failed"
        }
      },
      "derived_from": "TrailTransfer status failed"
    },
    {
      "code": "transfer.checksum_mismatch",
      "namespace": "transfer",
      "severity": "error",
      "meaning": "The checksum of a file read back from the target differs from the source.",
      "producer_kinds": [
        "transfer-worker"
      ],
      "example": {
        "event_type": "transfer.job.result",
        "payload": {
          "action": "copy",
          "status": "failed",
          "file": "report.csv",
          "source_sha256": "sha256:…",
          "target_sha256": "sha256:…",
          "reason_code": "transfer.checksum_mismatch"
        }
      },
      "derived_from": "TrailTransfer status failed"
    },
    {
      "code": "transfer.partial",
      "namespace": "transfer",
      "severity": "error",
      "meaning": "Some files reached the target, others did not; the payload lists the failed ones.",
      "producer_kinds": [
        "transfer-worker"
      ],
      "example": {
        "event_type": "transfer.job.result",
        "payload": {
          "action": "move",
          "status": "failed",
          "files": 14,
          "files_failed": [
            "batch-07/f-09.csv"
          ],
          "reason_code": "transfer.partial"
        }
      },
      "derived_from": "TrailTransfer status failed"
    },
    {
      "code": "transfer.cancelled",
      "namespace": "transfer",
      "severity": "warning",
      "meaning": "An operator or the scheduler cancelled the job before it finished.",
      "producer_kinds": [
        "transfer-worker"
      ],
      "example": {
        "event_type": "transfer.job.result",
        "payload": {
          "action": "sync",
          "status": "cancelled",
          "files": 3,
          "reason_code": "transfer.cancelled"
        }
      },
      "derived_from": "TrailTransfer status cancelled"
    },
    {
      "code": "transfer.schema_violation",
      "namespace": "transfer",
      "severity": "warning",
      "meaning": "The job command did not match the command schema and was rejected before execution.",
      "producer_kinds": [
        "transfer-worker"
      ],
      "example": {
        "event_type": "transfer.job.rejected",
        "payload": {
          "status": "rejected",
          "errors": [
            "/target: required"
          ],
          "reason_code": "transfer.schema_violation"
        }
      },
      "derived_from": "TrailTransfer rejection reason schema_violation"
    },
    {
      "code": "transfer.policy_violation",
      "namespace": "transfer",
      "severity": "warning",
      "meaning": "The transfer policy does not allow this action, source or target; the job was rejected before execution.",
      "producer_kinds": [
        "transfer-worker"
      ],
      "example": {
        "event_type": "transfer.job.rejected",
        "payload": {
          "status": "rejected",
          "action": "move",
          "target": "s3://public/…",
          "reason_code": "transfer.policy_violation"
        }
      },
      "derived_from": "TrailTransfer rejection reason policy_violation"
    },
    {
      "code": "transfer.duplicate_job_id",
      "namespace": "transfer",
      "severity": "warning",
      "meaning": "A job with this job_id was already accepted; the second submission was rejected.",
      "producer_kinds": [
        "transfer-worker"
      ],
      "example": {
        "event_type": "transfer.job.rejected",
        "payload": {
          "status": "rejected",
          "job_id": "job-1002",
          "reason_code": "transfer.duplicate_job_id"
        }
      },
      "derived_from": "TrailTransfer rejection reason duplicate_job_id"
    },
    {
      "code": "transfer.too_many_jobs",
      "namespace": "transfer",
      "severity": "warning",
      "meaning": "The worker's concurrency limit was reached; the job was rejected and may be resubmitted.",
      "producer_kinds": [
        "transfer-worker"
      ],
      "example": {
        "event_type": "transfer.job.rejected",
        "payload": {
          "status": "rejected",
          "running": 8,
          "limit": 8,
          "reason_code": "transfer.too_many_jobs"
        }
      },
      "derived_from": "TrailTransfer rejection reason too_many_jobs"
    },
    {
      "code": "mqtt.allowed",
      "namespace": "mqtt",
      "severity": "info",
      "meaning": "The broker allowed the action. Generic code for allow decisions; a producer MAY omit reason_code on an allow, and the reference broker sets none.",
      "producer_kinds": [
        "broker"
      ],
      "example": {
        "event_type": "mqtt.decision.allow",
        "payload": {
          "client_id": "sensor-gw-3",
          "topic": "plant/line1/telemetry",
          "action": "publish",
          "access_decision": "allow",
          "reason_code": "mqtt.allowed"
        }
      },
      "derived_from": "examples/broker-export.jsonl (records 0, 2); the reference broker leaves the reason of an allow empty"
    },
    {
      "code": "mqtt.acl_unauthenticated",
      "namespace": "mqtt",
      "severity": "warning",
      "meaning": "The client had no authenticated session; the action was refused before any rule was consulted.",
      "producer_kinds": [
        "broker"
      ],
      "example": {
        "event_type": "mqtt.decision.deny",
        "payload": {
          "client_id": "anon-7f",
          "topic": "plant/line1/telemetry",
          "action": "subscribe",
          "access_decision": "deny",
          "reason_code": "mqtt.acl_unauthenticated"
        }
      },
      "derived_from": "reference broker authorizer, reason acl_unauthenticated",
      "related": [
        "actor.auth"
      ]
    },
    {
      "code": "mqtt.acl_anonymous_restricted_topic",
      "namespace": "mqtt",
      "severity": "warning",
      "meaning": "The client used the anonymous identity and the topic lies outside the area open to anonymous clients.",
      "producer_kinds": [
        "broker"
      ],
      "example": {
        "event_type": "mqtt.decision.deny",
        "payload": {
          "client_id": "kiosk-2",
          "topic": "plant/line1/telemetry",
          "action": "subscribe",
          "access_decision": "deny",
          "reason_code": "mqtt.acl_anonymous_restricted_topic"
        }
      },
      "derived_from": "reference broker authorizer, reason acl_anonymous_restricted_topic"
    },
    {
      "code": "mqtt.acl_insufficient_permissions",
      "namespace": "mqtt",
      "severity": "warning",
      "meaning": "The identity holds no role the broker recognises, so no topic rule can apply to it.",
      "producer_kinds": [
        "broker"
      ],
      "example": {
        "event_type": "mqtt.decision.deny",
        "payload": {
          "client_id": "svc-legacy",
          "topic": "plant/line1/telemetry",
          "action": "publish",
          "access_decision": "deny",
          "roles": [
            "unknown-role"
          ],
          "reason_code": "mqtt.acl_insufficient_permissions"
        }
      },
      "derived_from": "reference broker authorizer, reason acl_insufficient_permissions"
    },
    {
      "code": "mqtt.acl_role_not_in_topic_scope",
      "namespace": "mqtt",
      "severity": "warning",
      "meaning": "No topic rule brings this topic into scope for any role the identity holds (deny by default).",
      "producer_kinds": [
        "broker"
      ],
      "example": {
        "event_type": "mqtt.decision.deny",
        "payload": {
          "client_id": "guest-app",
          "topic": "plant/line1/control",
          "action": "publish",
          "access_decision": "deny",
          "reason_code": "mqtt.acl_role_not_in_topic_scope"
        }
      },
      "derived_from": "reference broker authorizer, reason acl_role_not_in_topic_scope; examples/broker-export.jsonl (record 1)"
    },
    {
      "code": "mqtt.acl_role_action_not_permitted",
      "namespace": "mqtt",
      "severity": "warning",
      "meaning": "A topic rule covers the topic for one of the identity's roles, but that role may not perform this operation (publish or subscribe).",
      "producer_kinds": [
        "broker"
      ],
      "example": {
        "event_type": "mqtt.decision.deny",
        "payload": {
          "client_id": "hmi-line1",
          "topic": "plant/line1/control",
          "action": "publish",
          "access_decision": "deny",
          "reason_code": "mqtt.acl_role_action_not_permitted"
        }
      },
      "derived_from": "reference broker authorizer, reason acl_role_action_not_permitted"
    },
    {
      "code": "mqtt.acl_policy_denied",
      "namespace": "mqtt",
      "severity": "warning",
      "meaning": "The action passed authentication and topic scope, and a further policy check that also considers the client id refused it.",
      "producer_kinds": [
        "broker"
      ],
      "example": {
        "event_type": "mqtt.decision.deny",
        "payload": {
          "client_id": "sensor-gw-3",
          "topic": "plant/line1/setpoints",
          "action": "publish",
          "access_decision": "deny",
          "reason_code": "mqtt.acl_policy_denied"
        }
      },
      "derived_from": "reference broker authorizer, reason acl_policy_denied",
      "related": [
        "policy"
      ]
    },
    {
      "code": "mqtt.authz_unknown_operation",
      "namespace": "mqtt",
      "severity": "error",
      "meaning": "The authorization request named an operation the authorizer does not know (neither publish, subscribe nor delivery); it was refused.",
      "producer_kinds": [
        "broker"
      ],
      "example": {
        "event_type": "mqtt.decision.deny",
        "payload": {
          "client_id": "sensor-gw-3",
          "topic": "plant/line1/telemetry",
          "action": "retain-clear",
          "access_decision": "deny",
          "reason_code": "mqtt.authz_unknown_operation"
        }
      },
      "derived_from": "reference broker authorizer, reason authz_unknown_operation"
    },
    {
      "code": "source.inventory_initial",
      "namespace": "source",
      "severity": "info",
      "meaning": "First complete browse of the source's address space after the bridge started.",
      "producer_kinds": [
        "source-bridge"
      ],
      "example": {
        "event_type": "source.inventory.changed",
        "payload": {
          "inventory_hash": "sha256:…",
          "count": 2,
          "reason_code": "source.inventory_initial"
        }
      },
      "derived_from": "examples/source-bridge.jsonl (record 0)"
    },
    {
      "code": "source.node_added",
      "namespace": "source",
      "severity": "info",
      "meaning": "A node appeared in the address space; the inventory fingerprint changed.",
      "producer_kinds": [
        "source-bridge"
      ],
      "example": {
        "event_type": "source.inventory.changed",
        "payload": {
          "inventory_hash": "sha256:…",
          "added": [
            "ns=2;s=Line1.Pressure"
          ],
          "reason_code": "source.node_added"
        }
      },
      "derived_from": "source.inventory.changed (SPEC.md 3.1)"
    },
    {
      "code": "source.node_removed",
      "namespace": "source",
      "severity": "warning",
      "meaning": "A node that values were read from disappeared from the address space; later records cannot refer to it.",
      "producer_kinds": [
        "source-bridge"
      ],
      "example": {
        "event_type": "source.inventory.changed",
        "payload": {
          "inventory_hash": "sha256:…",
          "removed": [
            "ns=2;s=Line1.Speed"
          ],
          "reason_code": "source.node_removed"
        }
      },
      "derived_from": "source.inventory.changed (SPEC.md 3.1)"
    },
    {
      "code": "source.node_changed",
      "namespace": "source",
      "severity": "warning",
      "meaning": "An attribute of a node that stays in the address space changed (data type, browse name or path, access level); values read before and after may not be comparable.",
      "producer_kinds": [
        "source-bridge"
      ],
      "example": {
        "event_type": "source.inventory.changed",
        "payload": {
          "inventory_hash": "sha256:…",
          "changed": [
            {
              "node_id": "ns=2;s=Line1.Speed",
              "field": "data_type",
              "old": "float32",
              "new": "float64"
            }
          ],
          "reason_code": "source.node_changed"
        }
      },
      "derived_from": "source.inventory.changed (SPEC.md 3.1); TrailSource inventory diff, member changed"
    },
    {
      "code": "source.quality_uncertain",
      "namespace": "source",
      "severity": "warning",
      "meaning": "The source delivered the value with quality uncertain (stale, sensor not calibrated, substituted).",
      "producer_kinds": [
        "source-bridge"
      ],
      "example": {
        "event_type": "source.value.observed",
        "payload": {
          "entity_key": "line1/temp",
          "value": "21.5",
          "quality": "uncertain",
          "reason_code": "source.quality_uncertain"
        }
      },
      "derived_from": "examples/source-bridge.jsonl (quality member)"
    },
    {
      "code": "source.quality_bad",
      "namespace": "source",
      "severity": "error",
      "meaning": "The source delivered the value with quality bad; the value must not be used as a measurement.",
      "producer_kinds": [
        "source-bridge"
      ],
      "example": {
        "event_type": "source.value.observed",
        "payload": {
          "entity_key": "line1/temp",
          "value": "0",
          "quality": "bad",
          "reason_code": "source.quality_bad"
        }
      },
      "derived_from": "examples/source-bridge.jsonl (quality member)"
    },
    {
      "code": "source.connection_lost",
      "namespace": "source",
      "severity": "error",
      "meaning": "The bridge lost the connection to the source; values that changed until it reconnects are not observed.",
      "producer_kinds": [
        "source-bridge"
      ],
      "example": {
        "event_type": "source.connection.changed",
        "payload": {
          "source_address": "opc.tcp://plc-7:4840",
          "state": "disconnected",
          "reason_code": "source.connection_lost"
        }
      },
      "derived_from": "examples/source-bridge.jsonl (context.source_status)"
    },
    {
      "code": "source.connection_restored",
      "namespace": "source",
      "severity": "info",
      "meaning": "The bridge reconnected to the source and resumed reading.",
      "producer_kinds": [
        "source-bridge"
      ],
      "example": {
        "event_type": "source.connection.changed",
        "payload": {
          "source_address": "opc.tcp://plc-7:4840",
          "state": "connected",
          "down_ms": 4200,
          "reason_code": "source.connection_restored"
        }
      },
      "derived_from": "examples/source-bridge.jsonl (context.source_status)"
    },
    {
      "code": "source.connection_established",
      "namespace": "source",
      "severity": "info",
      "meaning": "The bridge opened its first session to the source since it started and began reading. A session after a lost or failed connection is source.connection_restored instead.",
      "producer_kinds": [
        "source-bridge"
      ],
      "example": {
        "event_type": "source.connection.changed",
        "payload": {
          "source_address": "opc.tcp://plc-7:4840",
          "state": "connected",
          "reason_code": "source.connection_established"
        }
      },
      "derived_from": "TrailSource source.connection.changed, first session of a process"
    },
    {
      "code": "source.connection_failed",
      "namespace": "source",
      "severity": "error",
      "meaning": "An attempt to open a session failed (unreachable, refused, certificate or identity rejected); nothing is read until a session is established. Recorded once per outage, not per retry.",
      "producer_kinds": [
        "source-bridge"
      ],
      "example": {
        "event_type": "source.connection.changed",
        "payload": {
          "source_address": "opc.tcp://plc-7:4840",
          "state": "disconnected",
          "error": "dial tcp 10.0.0.7:4840: connect: connection refused",
          "reason_code": "source.connection_failed"
        }
      },
      "derived_from": "TrailSource source.connection.changed, start against an unreachable source"
    },
    {
      "code": "source.connection_closed",
      "namespace": "source",
      "severity": "info",
      "meaning": "The bridge closed the session on purpose, usually because it is stopping. Not a failure; values that change afterwards are not observed until it reads again.",
      "producer_kinds": [
        "source-bridge"
      ],
      "example": {
        "event_type": "source.connection.changed",
        "payload": {
          "source_address": "opc.tcp://plc-7:4840",
          "state": "disconnected",
          "detail": "bridge stopping",
          "reason_code": "source.connection_closed"
        }
      },
      "derived_from": "TrailSource source.connection.changed, orderly shutdown"
    },
    {
      "code": "source.certificate_rejected",
      "namespace": "source",
      "severity": "error",
      "meaning": "The bridge refused the source's certificate: not in its trust list, outside its validity period, revoked or of unknown revocation status, issued for another application, or not matching a configured pin. Nothing is read until an administrator trusts the certificate; the bridge keeps a copy for review.",
      "producer_kinds": [
        "source-bridge"
      ],
      "example": {
        "event_type": "source.connection.changed",
        "payload": {
          "source_address": "opc.tcp://plc-7:4840",
          "state": "disconnected",
          "check": "untrusted",
          "certificate_thumbprint": "c75e5e8f51168ba9aa9fd4af07836de63850e71f",
          "rejected_file": "pki/rejected/c75e5e8f51168ba9aa9fd4af07836de63850e71f.der",
          "reason_code": "source.certificate_rejected"
        }
      },
      "derived_from": "TrailSource trust list (OPC UA trusted/ and rejected/ directories)"
    },
    {
      "code": "source.queue_overflow",
      "namespace": "source",
      "severity": "error",
      "meaning": "Values arrived faster than the bridge could seal them and were dropped; the payload counts them.",
      "producer_kinds": [
        "source-bridge"
      ],
      "example": {
        "event_type": "source.value.dropped",
        "payload": {
          "entity_key": "line1/speed",
          "dropped": 37,
          "reason_code": "source.queue_overflow"
        }
      },
      "derived_from": "producer-side loss, see common.gap"
    },
    {
      "code": "ml.metrics_accepted",
      "namespace": "ml",
      "severity": "info",
      "meaning": "The run's metrics meet the acceptance criteria of the recipe named in policy.",
      "producer_kinds": [
        "ml-pipeline"
      ],
      "example": {
        "event_type": "ml.run.completed",
        "payload": {
          "run_id": "run-7f3a",
          "metrics": {
            "dice": "0.9132"
          },
          "decision": {
            "threshold": "0.9000"
          },
          "reason_code": "ml.metrics_accepted"
        }
      },
      "derived_from": "examples/ml-pipeline.jsonl (record 1)"
    },
    {
      "code": "ml.metrics_below_threshold",
      "namespace": "ml",
      "severity": "warning",
      "meaning": "The run completed but a metric is below the recipe's acceptance threshold; the model is not released.",
      "producer_kinds": [
        "ml-pipeline"
      ],
      "example": {
        "event_type": "ml.run.completed",
        "payload": {
          "run_id": "run-81c2",
          "metrics": {
            "dice": "0.8710"
          },
          "decision": {
            "threshold": "0.9000"
          },
          "reason_code": "ml.metrics_below_threshold"
        }
      },
      "derived_from": "examples/ml-pipeline.jsonl (decision member)"
    },
    {
      "code": "ml.recipe_not_approved",
      "namespace": "ml",
      "severity": "error",
      "meaning": "The run used a recipe whose policy.status is not approved or active; its results must not be released.",
      "producer_kinds": [
        "ml-pipeline"
      ],
      "example": {
        "event_type": "ml.run.started",
        "payload": {
          "run_id": "run-81c3",
          "recipe_status": "draft",
          "reason_code": "ml.recipe_not_approved"
        }
      },
      "derived_from": "policy.status (SPEC.md 3.3)"
    },
    {
      "code": "ml.data_fingerprint_mismatch",
      "namespace": "ml",
      "severity": "error",
      "meaning": "The fingerprint of the input data differs from the one the recipe declares; the run is not comparable.",
      "producer_kinds": [
        "ml-pipeline"
      ],
      "example": {
        "event_type": "ml.run.started",
        "payload": {
          "run_id": "run-81c4",
          "data_fingerprint": "sha256:…",
          "expected_data_fingerprint": "sha256:…",
          "reason_code": "ml.data_fingerprint_mismatch"
        }
      },
