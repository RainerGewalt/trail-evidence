            "x": null
          },
          "ctrl": "tab\tnewline\ncr\rbs\bff\fnul\u0000unit\u001fdel\u007fquote\"backslash\\slash/",
          "umlaut": "Füße und Größe",
          "emoji": "🚀 Rakete",
          "mixed": "αβγ 日本語 עברית",
          "！": "fullwidth exclamation U+FF01",
